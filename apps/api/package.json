{
  "name": "@nosh/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --include ../../packages/contracts/src/**/*.ts src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/cli.ts",
    "db:reset": "tsx src/db/cli.ts --reset"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@nosh/contracts": "workspace:*",
    "@nosh/meal-planning": "workspace:*",
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
